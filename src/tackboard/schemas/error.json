{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tackboard:schema:error",
  "title": "tackboard error document",
  "schema_version": 1,
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object"
        }
      },
      "required": [
        "code",
        "message",
        "exit_code",
        "retryable",
        "details"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "error"
  ],
  "additionalProperties": false
}

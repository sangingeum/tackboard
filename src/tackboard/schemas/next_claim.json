{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tackboard:schema:next_claim",
  "title": "tackboard next_claim document",
  "schema_version": 1,
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "stale_claims": {
      "type": "integer",
      "minimum": 0,
      "description": "active claims at or past the configured stale threshold"
    },
    "task": {
      "anyOf": [
        {
          "$ref": "urn:tackboard:schema:task#/$defs/task"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "task",
    "stale_claims"
  ],
  "additionalProperties": false
}

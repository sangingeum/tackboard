{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tackboard:schema:deps",
  "title": "tackboard deps document",
  "schema_version": 1,
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string"
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "urn:tackboard:schema:task#/$defs/task"
      }
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "tasks"
  ],
  "additionalProperties": false
}

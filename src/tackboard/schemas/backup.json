{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tackboard:schema:backup",
  "title": "tackboard backup document",
  "schema_version": 1,
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "ok": {
      "type": "boolean"
    },
    "database": {
      "type": "string"
    },
    "operation": {
      "const": "backup"
    },
    "backup": {
      "type": "string"
    },
    "source_application_id": {
      "type": "integer"
    },
    "database_schema_version": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "ok",
    "database",
    "operation",
    "backup",
    "source_application_id",
    "database_schema_version"
  ],
  "additionalProperties": false
}

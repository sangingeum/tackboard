{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tackboard:schema:board",
  "title": "tackboard board document",
  "schema_version": 1,
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "type": "string"
    },
    "counts": {
      "type": "object",
      "properties": {
        "tasks": {
          "type": "integer",
          "minimum": 0
        },
        "backlog": {
          "type": "integer",
          "minimum": 0
        },
        "ready": {
          "type": "integer",
          "minimum": 0
        },
        "in_progress": {
          "type": "integer",
          "minimum": 0
        },
        "review": {
          "type": "integer",
          "minimum": 0
        },
        "done": {
          "type": "integer",
          "minimum": 0
        },
        "cancelled": {
          "type": "integer",
          "minimum": 0
        },
        "eligible": {
          "type": "integer",
          "minimum": 0
        },
        "reviewable": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        },
        "claimed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "tasks",
        "backlog",
        "ready",
        "in_progress",
        "review",
        "done",
        "cancelled",
        "eligible",
        "reviewable",
        "blocked",
        "claimed"
      ],
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "urn:tackboard:schema:task#/$defs/task"
      }
    }
  },
  "required": [
    "schema_version",
    "project",
    "counts"
  ],
  "additionalProperties": false
}

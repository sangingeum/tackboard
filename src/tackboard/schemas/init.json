{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tackboard:schema:init",
  "title": "tackboard init document",
  "schema_version": 1,
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "ok": {
      "type": "boolean"
    },
    "database": {
      "type": "string"
    },
    "operation": {
      "const": "init"
    },
    "created": {
      "type": "boolean"
    },
    "project_label": {
      "type": "string"
    },
    "database_schema_version": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "ok",
    "database",
    "operation",
    "created",
    "project_label",
    "database_schema_version"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tackboard:schema:note",
  "title": "tackboard note document",
  "schema_version": 1,
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "changed": {
      "type": "boolean"
    },
    "event": {
      "$ref": "urn:tackboard:schema:task#/$defs/note"
    }
  },
  "required": [
    "schema_version",
    "changed",
    "event"
  ],
  "additionalProperties": false
}

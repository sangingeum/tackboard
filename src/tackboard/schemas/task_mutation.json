{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tackboard:schema:task_mutation",
  "title": "tackboard task_mutation document",
  "schema_version": 1,
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "changed": {
      "type": "boolean"
    },
    "task": {
      "anyOf": [
        {
          "$ref": "urn:tackboard:schema:task#/$defs/task"
        },
        {
          "type": "null"
        }
      ]
    },
    "active_dependents": {
      "type": "array",
      "items": {
        "$ref": "urn:tackboard:schema:task#/$defs/task"
      }
    }
  },
  "required": [
    "schema_version",
    "changed",
    "task"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tackboard:schema:plan_apply",
  "title": "tackboard plan_apply document",
  "schema_version": 1,
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "dry_run": {
      "type": "boolean"
    },
    "source": {
      "type": "string"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "key": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "key",
          "title"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "dry_run",
    "source",
    "count",
    "tasks"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tackboard:schema:history_since",
  "title": "tackboard history_since document",
  "schema_version": 1,
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "urn:tackboard:schema:task#/$defs/event"
      }
    },
    "order": {
      "const": "asc"
    },
    "since": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "items",
    "order",
    "since"
  ],
  "additionalProperties": false
}
